# SkinSense Web Environment Variables
# Copy this file to .env.local and fill in your values.
# No secrets or accounts are needed for public pages and /demo mode.

# Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public anonymous key (Project Settings > API > anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Google OAuth Web Application Client ID (Google Cloud Console > Credentials > Web Client)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Playwright E2E only: Supabase service_role key (Project Settings > API > service_role)
# NEVER expose this key with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=

# Optional: URL of deployed environment to run Playwright against instead of local dev server
# E2E_BASE_URL=https://your-deployment.vercel.app
