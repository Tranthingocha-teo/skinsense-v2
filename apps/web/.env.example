# SkinSense Web Environment Variables
# Copy this file to .env.local and fill in your values.
# No secrets or accounts are needed for public pages and /demo mode.

# Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous / publishable key (Project Settings > API > anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Google OAuth Web Application Client ID (Google Cloud Console > Credentials > Web Client)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Server-only Supabase service_role key (Project Settings > API > service_role)
# NEVER expose this key with NEXT_PUBLIC_! Keep Sensitive in Vercel Production Env.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Cloudinary credentials for Shop product image uploads (NEVER prefix with NEXT_PUBLIC_!)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skinsense/products

# Optional: URL of deployed environment to run Playwright against instead of local dev server
# E2E_BASE_URL=https://skinsense-v2-topaz.vercel.app
