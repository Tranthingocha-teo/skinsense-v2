# SkinSense Mobile (Expo React Native) Environment Variables
# Copy this file to .env and fill in your values.
# No secrets or accounts are needed for local typecheck and test execution.

# Supabase project URL (same as NEXT_PUBLIC_SUPABASE_URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public anonymous key (same as NEXT_PUBLIC_SUPABASE_ANON_KEY)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Google OAuth Web Application Client ID (used by Android to request ID tokens)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
