{
  "cli": {
    "version": ">= 24.1.2",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "bun": "1.4.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lint -x lintVitalRelease -x lintVitalAnalyzeRelease"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "EAS_BUILD_DISABLE_BUNDLE_JAVASCRIPT_STEP": "1",
        "GRADLE_OPTS": "-Dorg.gradle.workers.max=3 -Xmx2048m"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
