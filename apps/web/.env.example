# SkinSense Web Environment Variables
# Copy this file to .env.local and fill in your values.
# No secrets or accounts are needed for public pages and /demo mode.

# Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://gzecjsqnehgrvkgnznec.supabase.co

# Supabase public anonymous key (Project Settings > API > anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DraqwwlZOU8GzqJbs0Q4XQ_K8waOjRd

# Google OAuth Web Application Client ID (Google Cloud Console > Credentials > Web Client)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Playwright E2E only: Supabase service_role key (Project Settings > API > service_role)
# NEVER expose this key with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=

# Optional: URL of deployed environment to run Playwright against instead of local dev server
# E2E_BASE_URL=https://your-deployment.vercel.app

# Cloudinary (Tải ảnh sản phẩm của Shop từ máy tính / Camera lên Cloudinary Console)
# Lấy tại: https://console.cloudinary.com/app/c-b0b4e93af564efab17bf3e2dccd238/image/home -> Settings -> API Keys
# Cách 1 (khuyên dùng - Signed Upload bảo mật ở server):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skinsense/products
# Cách 2 (hoặc dùng CLOUDINARY_URL / Unsigned Upload Preset):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_UPLOAD_PRESET=
